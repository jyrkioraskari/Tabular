{
  "name": "TabulatRDM",
  "version": "1.0.0",
  "description": "Simple React Flow app",
  "author": "Jyrki Oraskari",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node server.js",
    "desktop": "npm run build && electron .",
    "dist:windows": "npm run build && electron-builder --win nsis portable"
  },
  "private": true,
  "allowScripts": {
    "esbuild": true,
    "electron": true,
    "sqlite3": false
  },
  "dependencies": {
    "@ro-kit/ui-widgets": "^1.0.43",
    "@ulb-darmstadt/shacl-form": "^3.0.4",
    "@xyflow/react": "^12.4.2",
    "jsonld": "^9.0.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet-editable": "^1.3.2",
    "leaflet.fullscreen": "^4.0.0",
    "n3": "^1.26.0",
    "rdfstore": "^0.9.17",
    "rdfxml-streaming-parser": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ro-crate": "^3.7.1",
    "shacl-engine": "^1.1.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "de.rwth.tabularrdm",
    "productName": "TabularRDM",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.js",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-Portable.${ext}"
    }
  }
}
